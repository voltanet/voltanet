{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV", "HOSTNAME", "PORT"],
  "noUpdateNotifier": true,
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "build": { "dependsOn": ["^build"] },
    "start": { "persistent": true },
    "db:seed": { "dependsOn": ["^db:seed"] },
    "db:generate": { "dependsOn": ["^db:generate"] },
    "db:migrate": { "dependsOn": ["^db:migrate"] },
    "db:studio": { "dependsOn": ["^db:studio"] },
    "format": { "dependsOn": ["^format"] },
    "check:code": { "dependsOn": ["^check:code"] },
    "check:types": { "dependsOn": ["^check:types"] }
  }
}
