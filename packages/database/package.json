{
  "name": "@repo/database",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "db:seed": "NODE_ENV=development bun -b ./scripts/db-seed.ts",
    "db:generate": "bunx -b drizzle-kit generate",
    "db:migrate": "bunx -b drizzle-kit migrate",
    "db:studio": "bunx -b drizzle-kit studio",
    "format": "biome format --write",
    "check": "biome check --write",
    "type-check": "tsc"
  },
  "exports": {
    ".": {
      "types": "./.types/database.d.ts",
      "default": "./database.ts"
    },
    "./schema": {
      "types": "./.types/schema/index.d.ts",
      "default": "./schema/index.ts"
    }
  },
  "devDependencies": {
    "@libsql/client": "^0.17.4",
    "@repo/shared": "workspace:*",
    "@repo/validation": "workspace:*",
    "@types/bun": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2"
  }
}
