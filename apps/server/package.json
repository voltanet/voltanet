{
  "name": "@repo/server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun -b --watch ./server.ts",
    "build": "bun -b ./scripts/build.ts",
    "start": "cd dist && bun -b ./server",
    "compile": "bun -b ./scripts/compile.ts",
    "format": "biome format --write",
    "check": "biome check --write",
    "type-check": "tsc"
  },
  "exports": {
    "./api": {
      "types": "./.types/router/client.d.ts",
      "default": "./router/client.ts"
    },
    "./auth": {
      "types": "./.types/utils/auth/client.d.ts",
      "default": "./utils/auth/client.ts"
    }
  },
  "devDependencies": {
    "@orpc/client": "^1.14.0",
    "@orpc/server": "^1.14.7",
    "@repo/database": "workspace:*",
    "@repo/shared": "workspace:*",
    "@types/bun": "^1.3.14",
    "better-auth": "^1.3.27",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.29",
    "zod": "^4.1.11"
  }
}
